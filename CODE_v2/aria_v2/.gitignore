# Eclipse / e2 studio workspace metadata (machine-specific, never share)
.metadata/
.recommenders/

# Per-project Eclipse/CDT settings that reference absolute local paths
.settings/
.cproject
.project
.launches/
venv/
.venv/
env/
__pycache__/
*.pyc

# Build output — regenerated by `make`, not source
Debug/
Release/
*.o
*.d
*.elf
*.map
*.bin
*.hex
*.su
*.i
*.list

# FSP-generated / regenerable configuration cache
*.pincfg.bak

# OS cruft
.DS_Store
Thumbs.db

# Editor swap/backup files
*~
*.swp
*.bak

# Logs pasted during debugging (your paste.txt build logs)
*.log